# ---- AI providers (keys live ONLY here, never in frontend JS) ----
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=          # optional (paid)
SEARCH_PROVIDER=gemini       # gemini | perplexity | claude | web  (the others are automatic fallbacks; web = free, no key)

# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest,gemini-flash-latest
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low          # low | medium | high  (low = fastest verdicts for the demo)
# PERPLEXITY_MODEL=sonar

# ---- Server ----
PORT=3000
PUBLIC_BASE_URL=             # your https ngrok / Cloudflare Tunnel URL (needed for OAuth, Telegram, reset links)
CORS_ORIGINS=*               # comma-separated; set to your Vercel/Netlify URL if the frontend is hosted separately

# ---- Limits ----
MAX_MEDIA_MB=16              # images, voice notes, videos
MAX_PDF_MB=10
RATE_LIMIT_PER_HOUR=20       # checks per user / per platform id
CHECKS_CACHE_TTL_HOURS=24    # 0 disables the result cache
UPLOAD_RETENTION_HOURS=24    # stored media is deleted after this

# ---- Supabase (Project Settings -> API Keys) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=           # publishable key (public)
SUPABASE_SERVICE_ROLE_KEY=   # secret key: server only, never commit or share
SUPABASE_JWT_SECRET=         # only for old projects on the legacy HS256 JWT secret
PUBLIC_WEB_URL=              # where users open the web app (defaults to PUBLIC_BASE_URL)

# ---- Messaging bots (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=

# ---- Your own public accounts (opened by the app cards on the site) ----
# Leave empty and each card opens that app with a ready-to-send "check with SachScan" share message.
# Never put accounts here that your team does not own.
WHATSAPP_NUMBER=             # e.g. 919876543210 (country code, no +)
TELEGRAM_BOT_USERNAME=       # e.g. SachScanCheckBot
DISCORD_INVITE_URL=          # server invite or bot install link (auto-built from DISCORD_APPLICATION_ID if empty)
CONTACT_EMAIL=               # opens Gmail compose to this address; also shown on the policy pages
X_HANDLE=
REDDIT_COMMUNITY=            # without r/
INSTAGRAM_HANDLE=
THREADS_HANDLE=

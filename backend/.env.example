# ---- AI providers (keys live ONLY here, never in frontend JS) ----
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=          # openrouter.ai -> Keys (one key, many models; paid per use, ':free' models are rate-limited)
# OPENROUTER_MODEL=google/gemini-2.5-flash      # any id from openrouter.ai/models (free tier: use a :free model)
# OPENROUTER_FALLBACK_MODELS=                    # comma-separated backups, tried automatically
# OPENROUTER_SEARCH_MODEL=                      # model used with OpenRouter web search (defaults to OPENROUTER_MODEL)
# LLM_PROVIDER_ORDER=openrouter,gemini,claude    # order for claim splitting + verdicts
PERPLEXITY_API_KEY=          # optional (paid)
SEARCH_PROVIDER=gemini       # gemini | openrouter | perplexity | claude | web  (the others are automatic fallbacks; web = free, no key)

# Optional model overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest,gemini-flash-latest
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low          # low | medium | high  (low = fastest verdicts for the demo)
# PERPLEXITY_MODEL=sonar

# ---- Server ----
PORT=3000
PUBLIC_BASE_URL=             # your https ngrok / Cloudflare Tunnel URL (needed for OAuth, Telegram, reset links)
CORS_ORIGINS=*               # comma-separated; set to your Vercel/Netlify URL if the frontend is hosted separately

# ---- Limits ----
MAX_MEDIA_MB=16              # images, voice notes, videos
MAX_PDF_MB=10
RATE_LIMIT_PER_HOUR=20       # checks per user / per platform id
CHECKS_CACHE_TTL_HOURS=24    # 0 disables the result cache
UPLOAD_RETENTION_HOURS=24    # stored media is deleted after this

# ---- Supabase (Project Settings -> API Keys) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=           # publishable key (public)
SUPABASE_SERVICE_ROLE_KEY=   # secret key: server only, never commit or share
SUPABASE_JWT_SECRET=         # only for old projects on the legacy HS256 JWT secret
PUBLIC_WEB_URL=              # where users open the web app (defaults to PUBLIC_BASE_URL)

# ---- WhatsApp Business Cloud API (SETUP.md section 4) ----
WHATSAPP_TOKEN=              # SECRET: access token (temporary 24 h, or permanent system-user token)
WHATSAPP_PHONE_NUMBER_ID=    # API Setup -> "Phone number ID" (not the phone number)
WHATSAPP_VERIFY_TOKEN=       # any random string; enter the same one in Meta's webhook settings
WHATSAPP_APP_SECRET=         # SECRET: App settings -> Basic -> App secret (verifies webhook signatures)
WHATSAPP_BOT_NUMBER=         # the bot's number, digits only, e.g. 15551234567 (also set in integrations.config.js)
# WHATSAPP_GRAPH_VERSION=v26.0

# ---- Discord bot (SETUP.md section 5; run: python -m bots.discord_bot) ----
DISCORD_BOT_TOKEN=           # SECRET: Developer Portal -> Bot -> Reset Token
DISCORD_APP_ID=              # Developer Portal -> General Information -> Application ID (also in integrations.config.js)

# ---- Telegram / Gmail: added in their steps ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CONTACT_EMAIL=               # shown on the policy pages
